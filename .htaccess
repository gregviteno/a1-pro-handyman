# A1 Pro Handyman — Apache config for SiteGround shared hosting

# ---- Force HTTPS + canonicalize to non-www ----
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ---- Custom 404 ----
ErrorDocument 404 /404.html

# ---- MIME types ----
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>

# ---- Compression ----
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---- Cache headers ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ---- Light security headers ----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(jpg|jpeg|png|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML/CSS/JS must revalidate on every request.
  #
  # The host was serving these with max-age=15552000 (180 days), overriding the
  # mod_expires rule above. Because css/styles.css has a fixed filename, a
  # returning visitor could hold a stale HTML page against a fresh stylesheet
  # for months - which renders as old markup styled by new CSS: purged classes
  # collapse and sections lose their backgrounds entirely.
  #
  # max-age=0 + must-revalidate means the browser always asks; ETag and
  # Last-Modified still return 304 when nothing changed, so the cost is one
  # conditional request, not a re-download. Images and fonts keep their
  # one-year immutable cache above.
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header unset Expires
  </FilesMatch>
</IfModule>
